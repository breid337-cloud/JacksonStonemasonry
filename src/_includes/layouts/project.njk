---
layout: layouts/base.njk
---
<article>
  <header class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Projects</p>
      <h1>{{ h1 or title }}</h1>
      <p class="lede">{{ lede }}</p>
    </div>
  </header>

  <div class="wrap article-grid">
    <div class="article-body">
      <dl class="project-facts">
        <div><dt>Location</dt><dd>{{ projectLocation }}</dd></div>
        <div><dt>Service</dt><dd><a href="{{ serviceUrl }}">{{ serviceName }}</a></dd></div>
        <div><dt>Stone</dt><dd>{{ stone }}</dd></div>
        <div><dt>Scope</dt><dd>{{ scope }}</dd></div>
      </dl>

      {{ content | safe }}
    </div>

    <aside class="article-aside">
      <div class="aside-card">
        <h2 class="aside-card__title">More Projects</h2>
        <ul class="aside-links">
          {%- for p in collections.projects %}
          <li><a href="{{ p.url }}"{% if p.url == page.url %} aria-current="page"{% endif %}>{{ p.data.title }}</a></li>
          {%- endfor %}
        </ul>
      </div>
      <div class="aside-card aside-card--cta">
        <h2 class="aside-card__title">A similar project in mind?</h2>
        <p>Send us photos of your wall or stonework for a free, no-obligation quotation.</p>
        <a class="btn btn--primary btn--block" href="/quote/">Get a Quote</a>
      </div>
    </aside>
  </div>
</article>
